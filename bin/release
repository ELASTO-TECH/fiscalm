#!/usr/bin/env python3
"""Check and prepare a local SemVer release. Never commit, tag, push or publish."""

from __future__ import annotations

import re
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def run(*args: str) -> None:
    subprocess.run(args, cwd=ROOT, check=True)


def main() -> None:
    if len(sys.argv) != 2 or not re.fullmatch(r"(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)", sys.argv[1]):
        raise SystemExit("usage: bin/release MAJOR.MINOR.PATCH (no prerelease)")
    version = sys.argv[1]
    if subprocess.check_output(["git", "status", "--porcelain"], cwd=ROOT):
        raise SystemExit("The tree must be clean, including untracked files.")
    manifest = ROOT / "pyproject.toml"
    current = tomllib.loads(manifest.read_text())["project"]["version"]
    if tuple(map(int, version.split("."))) < tuple(map(int, current.split("."))):
        raise SystemExit("The release version cannot go backwards.")
    run("bin/test.sh", "full")  # the same pre-merge checks as CI: Ruff, Python, app
    if subprocess.check_output(["git", "status", "--porcelain"], cwd=ROOT):
        raise SystemExit("Checks changed the tree; review those changes before releasing.")
    manifest.write_text(manifest.read_text().replace(f'version = "{current}"', f'version = "{version}"', 1))
    run("uv", "lock")
    print(f"Prepared {version}. Review git diff, commit the version bump, then:")
    print(f"  git tag -a v{version} -m 'fiscalm {version}'")
    print("Write short user-facing release notes in Romanian and obtain George's approval.")
    print("Only then push the reviewed commit/tag and create the GitHub Release manually.")
    print("No commit, tag, push or publication was performed.")


if __name__ == "__main__":
    main()
